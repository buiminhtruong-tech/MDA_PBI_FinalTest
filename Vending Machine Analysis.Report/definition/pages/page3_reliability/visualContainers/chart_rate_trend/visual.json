            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_Sales"
                    }
                  },
                  "Property": "Overall Success Rate"
                }
              },
              "queryRef": "Fact_Sales.Overall Success Rate"
            }
          ]
        }
      }
    }
  }
}