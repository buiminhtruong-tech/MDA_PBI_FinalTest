	measure 'Refill to Sales Ratio' = DIVIDE([Total Transfer Value], [Successful Sales Value], 0)
		formatString: 0.00%
		lineageTag: c7eedc2f-c36a-4b41-86f5-2e7a086697c1

	measure 'Total PO Count' = COUNTROWS(Fact_PurchaseOrder)
		formatString: #,0
		lineageTag: 79993197-3ffd-4fa1-a532-6b8bfee28f21

	measure 'Total Inbound Value' = SUM(Fact_InboundInventory[TotalAmount])
		formatString: #,0 ₫
		lineageTag: 4a14053f-78e2-4c0e-b357-64a674d5e90e

	measure 'Average AOV' = DIVIDE([Successful Sales Value], [Successful Transactions], 0)
		formatString: #,0 ₫
		lineageTag: cf09bcf1-9999-45ed-9592-ebb518a44b1a

	measure 'Covid Lockdown Revenue' = CALCULATE([Successful Sales Value], Dim_Date[IsCovidLockdown] = TRUE())
		formatString: #,0 ₫
		lineageTag: 35799d05-1651-443c-8593-a2809b437c6a

	measure 'Top 20% Machine Revenue Share' =
			VAR MachineCount =
				COUNTROWS(ALLSELECTED(Dim_Machine[MachineCode]))
			VAR TopMachineCount =
				MAX(1, ROUNDUP(MachineCount * 0.2, 0))
			VAR TopRevenue =
				CALCULATE(
					[Successful Sales Value],
					TOPN(
						TopMachineCount,
						ALLSELECTED(Dim_Machine[MachineCode]),
						[Successful Sales Value], DESC,
						Dim_Machine[MachineCode], ASC
					)
				)
			VAR TotalRevenue =
				CALCULATE(
					[Successful Sales Value],
					ALLSELECTED(Dim_Machine[MachineCode])
				)
			RETURN
				DIVIDE(TopRevenue, TotalRevenue, 0)
		formatString: 0.00%
		lineageTag: 08dbae0f-6239-429d-a3dd-a0657b339471

	measure 'Data Quality Integrity Index' = [Refund Data Integrity Rate]
		formatString: 0.00%
		lineageTag: f705250f-0a1c-4689-ab0e-b5b95351eacb

	measure 'Report Title' = "SkillsHub Vietnam"
		lineageTag: 1c35ecde-0dc7-4ec5-9549-4c2d1816dfcd

	measure 'Failed Rate' = DIVIDE([Failed Attempts], [Total Sales Rows], 0)
		formatString: 0.00%
		lineageTag: 92860210-ebd2-4742-adf3-3a5c1101ae8d

	measure 'Refund Rate' = DIVIDE([Refund Transactions], [Total Sales Rows], 0)
		formatString: 0.00%
		lineageTag: 53f04750-f6e8-4ba7-b1e1-cd9312b21908

	measure 'Total Machines Count' = COUNTROWS(Dim_Machine)
		formatString: #,0
		lineageTag: 462f0169-4e32-4ea2-93e7-43a3ba076c60

	measure 'Revenue per Refill' = DIVIDE([Successful Sales Value], [Total Transfer Count], 0)
		formatString: #,0 ₫
		lineageTag: 795012ed-bb68-415f-ade5-39b86727725a

	measure 'Sales to Transfer Value Ratio' = DIVIDE([Successful Sales Value], [Total Transfer Value], 0)
		formatString: 0.00%
		lineageTag: 615734b7-8417-4499-8953-1970ff704bd6

	measure 'Average PO Lead Days' =
			AVERAGEX(
				FILTER(
					Fact_PurchaseOrder,
					NOT ISBLANK(Fact_PurchaseOrder[ReceivingDateKey]) &&
						NOT ISBLANK(Fact_PurchaseOrder[OrderDateKey])
				),
				VAR OrderKey =
					Fact_PurchaseOrder[OrderDateKey]
				VAR ReceiveKey =
					Fact_PurchaseOrder[ReceivingDateKey]
				VAR OrderDate =
					DATE(
						QUOTIENT(OrderKey, 10000),
						QUOTIENT(MOD(OrderKey, 10000), 100),
						MOD(OrderKey, 100)
					)
				VAR ReceiveDate =
					DATE(
						QUOTIENT(ReceiveKey, 10000),
						QUOTIENT(MOD(ReceiveKey, 10000), 100),
						MOD(ReceiveKey, 100)
					)
				RETURN
					DATEDIFF(OrderDate, ReceiveDate, DAY)
			)
		formatString: 0.0
		lineageTag: 137f0a24-69cc-4728-8f9b-1b0547ca42b8

	measure 'Revenue per Active Machine' = DIVIDE([Successful Sales Value], [Active Machines Count], 0)
		formatString: #,0 ₫
		lineageTag: 4a8b54da-41fc-43e3-819e-702a77e5cde8

	measure 'Refund Data Integrity Rate' = 1 - DIVIDE([DQ Refund Exceptions], [Total Sales Rows], 0)
		formatString: 0.00%
		lineageTag: dfa360f4-533c-4721-97fb-2204e3a17b3a

	measure 'Machine Revenue Rank' = RANKX(ALLSELECTED(Dim_Machine[MachineCode]), [Successful Sales Value],, DESC, Dense)
		formatString: #,0
		lineageTag: d3ce1c9b-6d2d-438c-b494-f275d71dd9fb

	measure 'Machine Action' =
			VAR RevenueValue =
				[Successful Sales Value]
			VAR AttemptCount =
				[Total Sales Rows]
			VAR SuccessRateValue =
				[Overall Success Rate]
			VAR RefillCount =
				[Total Transfer Count]
			VAR RefillEfficiency =
				[Revenue per Refill]
			VAR RevenueMedian =
				MEDIANX(
					ALLSELECTED(Dim_Machine[MachineCode]),
					CALCULATE([Successful Sales Value])
				)
			VAR AttemptsMedian =
				MEDIANX(
					ALLSELECTED(Dim_Machine[MachineCode]),
					CALCULATE([Total Sales Rows])
				)
			VAR SuccessBenchmark =
				CALCULATE(
					[Overall Success Rate],
					ALLSELECTED(Dim_Machine[MachineCode])
				)
			VAR EfficiencyMedian =
				MEDIANX(
					ALLSELECTED(Dim_Machine[MachineCode]),
					CALCULATE([Revenue per Refill])
				)
			RETURN
				SWITCH(
					TRUE(),
					RevenueValue >= RevenueMedian &&
						SuccessRateValue >= SuccessBenchmark, "KEEP / SCALE",
					AttemptCount >= AttemptsMedian &&
						SuccessRateValue < SuccessBenchmark, "FIX",
					AttemptCount < AttemptsMedian &&
						SuccessRateValue >= SuccessBenchmark, "RELOCATE",
					RevenueValue < RevenueMedian &&
						SuccessRateValue < SuccessBenchmark &&
						RefillCount > 0 &&
						RefillEfficiency < EfficiencyMedian, "REVIEW / REPLACE",
					"MONITOR"
				)
		lineageTag: dfc1ba63-f4ba-4d1c-8f67-c992dae02217

	measure 'Machine Action Reason' =
			VAR ActionLabel =
				[Machine Action]
			RETURN
				SWITCH(
					ActionLabel,
					"KEEP / SCALE", "Revenue and reliability are above the selected-fleet benchmark",
					"FIX", "Demand is material but transaction success is below benchmark",
					"RELOCATE", "Machine works reliably but demand is below the fleet median",
					"REVIEW / REPLACE", "Low revenue, low reliability and weak refill efficiency",
					"Insufficient evidence; continue monitoring"
				)
		lineageTag: 853ed0e7-231b-4af7-94f5-862ca8482cc4

	measure 'Machine Action Priority' = SWITCH([Machine Action], "FIX", 1, "REVIEW / REPLACE", 2, "RELOCATE", 3, "MONITOR", 4, "KEEP / SCALE", 5, 9)
		formatString: 0
		lineageTag: 869e04dc-20dd-4ff4-93d7-628b1089a3e8

	measure 'Machine Action Priority Label' = SWITCH([Machine Action], "FIX", "P1 - FIX", "REVIEW / REPLACE", "P2 - REVIEW / REPLACE", "RELOCATE", "P3 - RELOCATE", "MONITOR", "P4 - MONITOR", "KEEP / SCALE", "P5 - KEEP / SCALE", "P9 - UNCLASSIFIED")
		lineageTag: 8911760a-e0eb-42b3-8acc-f9c0fe50f061

	measure 'Keep Scale Machines' = SUMX(VALUES(Dim_Machine[MachineCode]), IF([Machine Action] = "KEEP / SCALE", 1, 0))
		formatString: #,0
		lineageTag: 9ee45b20-4211-4295-8b12-faa4eb77fe57

	measure 'Fix Machines' = SUMX(VALUES(Dim_Machine[MachineCode]), IF([Machine Action] = "FIX", 1, 0))
		formatString: #,0
		lineageTag: a811269d-9171-4ece-bced-107d2e817858

	measure 'Relocate Machines' = SUMX(VALUES(Dim_Machine[MachineCode]), IF([Machine Action] = "RELOCATE", 1, 0))
		formatString: #,0
		lineageTag: 3ca11c48-2c61-4bdd-81bd-86ef3514ffb1

	measure 'Review Replace Machines' = SUMX(VALUES(Dim_Machine[MachineCode]), IF([Machine Action] = "REVIEW / REPLACE", 1, 0))
		formatString: #,0
		lineageTag: 70b880b6-25ef-4e04-ae5d-306343e86234

	measure 'Monitor Machines' = SUMX(VALUES(Dim_Machine[MachineCode]), IF([Machine Action] = "MONITOR", 1, 0))
		formatString: #,0
		lineageTag: d0013059-9506-427d-9c96-fd6851f2e12c

	measure 'Machines with Transactions' = DISTINCTCOUNT(Fact_Sales[MachineCode])
		formatString: #,0
		lineageTag: 91420eaf-84f6-4d19-b1e8-3dde5d5dff31

	/// Operational watch line for failed transaction share.
	measure 'Failure Watch Threshold' = IF([Total Sales Rows] > 0, 0.15)
		formatString: 0.00%
		lineageTag: 9b71e5e7-3f5a-4d3d-9493-94898d8f3c8b

