table Fact_Sales
	lineageTag: 75e51fcb-c7a6-4c2a-ab60-d9e5dfd3d536

	measure 'Total Sales Rows' = COUNTROWS(Fact_Sales)
		formatString: #,0
		lineageTag: ca71259e-3e0f-44ee-9cc5-aa5afcd230b7

	measure 'Successful Transactions' = CALCULATE([Total Sales Rows], Fact_Sales[TransactionOutcomeGroup] = "Success")
		formatString: #,0
		lineageTag: d0b9cf58-a3b9-4ee6-bba6-969a86ad6833

	measure 'Failed Attempts' = CALCULATE([Total Sales Rows], Fact_Sales[TransactionOutcomeGroup] = "Failed_or_Cancelled")
		formatString: #,0
		lineageTag: d0f474ac-9a3d-482b-8dde-525d962ab85a

	measure 'Refund Transactions' = CALCULATE([Total Sales Rows], Fact_Sales[TransactionOutcomeGroup] = "Refunded")
		formatString: #,0
		lineageTag: b972d533-27a3-4121-af6e-d91737b7aae6

	measure 'Overall Success Rate' = DIVIDE([Successful Transactions], [Total Sales Rows], 0)
		formatString: 0.00%
		lineageTag: 832c7218-d0f1-4de5-8c7f-4d057754c3c2

	measure 'Success Rate Pre 29/04' = CALCULATE([Overall Success Rate], Dim_Date[FullDate] < DATE(2020,4,29))
		formatString: 0.00%
